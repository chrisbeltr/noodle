<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>rotting</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap');

        html {
            width: 100%;
            height: 100%;
        }

        body {
            height: 100%;
            margin: 0;

            font-family: "Julius Sans One", monospace;
            font-size: 2rem;
            letter-spacing: -2px;
            background-color: black;
            color: white;
        }

        .bl {
            position: absolute;
            bottom: 5px;
            left: 5px;

            display: flex;
        }

        .multi {
            height: 60px;

            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .top {
            position: absolute;
            top: 0;
        }

        .middle {
            position: absolute;
            top: 0;
            bottom: 0;

            display: flex;
            align-items: center;
        }

        .rotting {
            align-self: flex-end;
        }
    </style>
</head>

<body>
    <div class="bl">
        <div class="can">I can&nbsp</div>
        <div class="multi">
            <div class="top">feel</div>
            <div class="middle">taste</div>
            <div class="bottom">smell</div>
        </div>
        <div class="rotting">&nbspmyself rotting.</div>
    </div>
</body>

</html>